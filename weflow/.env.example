# WeFlow — gestor de tarefas da Lovet Distribuidora. Copie para .env (não versionado).

# Portas (a tela do Vite usa WEB_PORT=5174 por linha de comando; veja README).
API_PORT=3101

# Segredo dos tokens de sessão. Obrigatório em produção. Gere um valor forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Entrada automática vinda do CRM (botão WeFlow). Use o MESMO valor no CRM
# (apps/crm/.env.local) e aqui; mínimo 24 caracteres. Sem isto o botão fica desligado.
SSO_SHARED_SECRET=

# Origem pública do WeFlow (links de convite e e-mails).
APP_URL=http://localhost:5174

# Conta do gestor criada na 1ª execução do banco local (opcional). Sem senha definida,
# a conta só entra pelo CRM.
# WEFLOW_GESTOR_EMAIL=gestor@lovet.local
# WEFLOW_GESTOR_PASSWORD=

# Produção: banco Supabase (sem estas variáveis o app usa o banco local em data/db.json).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Opcional: e-mails de aviso (Resend).
# RESEND_API_KEY=
# EMAIL_FROM=WeFlow <avisos@seudominio.com.br>
