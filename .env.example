# CRM Lovet Distribuidora — variaveis de ambiente.
# Copie os valores relevantes para n8n-evolution/.env (stack Docker) e para
# apps/crm/.env.local (desenvolvimento local). Nenhum destes e versionado.
# NUNCA coloque chaves reais neste arquivo: ele e so um modelo.

# ── Banco ──────────────────────────────────────────────────────────────────
# Um Postgres, um database "lovet", schemas: shared e crm.
#
# Dentro da rede Docker o host e "postgres:5432".
# No host, o stack publica em 127.0.0.1:5433 (a 5432 costuma estar ocupada
# por um PostgreSQL instalado localmente).
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=postgres

CRM_DATABASE_URL=postgresql://crm_app:troque-me@postgres:5432/lovet

# ── WhatsApp (Evolution API) ───────────────────────────────────────────────
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-me

# ── n8n ────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=troque-me
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-me

# ── Integracao n8n → CRM ───────────────────────────────────────────────────
# Token exigido no header x-webhook-token pelas rotas /api/wa/* do CRM.
WA_API_TOKEN=troque-me

# ── Diversos ───────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo
CRM_PUBLIC_URL=http://localhost:3000

# ── Producao (opcional) ────────────────────────────────────────────────────
# Banco gerenciado: use a URL de conexao do provedor.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
# Storage de objetos (audio do FeedMeet, midia de campanha). Sem as duas, grava em disco.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=crm-media
# IA: Claude. Sem a chave, cai no Ollama (OLLAMA_URL).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Transcricao do FeedMeet na nuvem (Groq, whisper-large-v3-turbo). Sem a chave, usa WHISPER_URL.
GROQ_API_KEY=
# WhatsApp pela WhatsGW (tem prioridade sobre a Evolution quando definida).
WHATSGW_API_KEY=
WHATSGW_PHONE_NUMBER=
# Vai na URL do webhook no painel da WhatsGW: /api/webhooks/whatsgw?token=<isto>
WHATSGW_WEBHOOK_TOKEN=
# HTTPS de verdade na frente: cookie de sessao so por TLS.
COOKIE_SECURE=true
